{
  "info": {
    "name": "AI Code Detector",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Detect",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "content-type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"def add(a, b): return a + b\",\n  \"language\": \"python\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/detect",
          "host": ["{{baseUrl}}"],
          "path": ["api", "detect"]
        }
      }
    }
  ]
}
